# Copy to .env and fill in real values. Never commit .env.

# Docker Hub (https://hub.docker.com/settings/security)
DOCKER_HUB_USER=githubuser
DOCKER_HUB_TOKEN=

# Image names (override if needed)
DOCKER_HUB_IMAGE=dockeruser/lx-music-sync-server
GHCR_IMAGE=ghcr.io/githubuser/lx-music-sync-server

# Tags to push (space-separated). Defaults to: latest <package.json version>
# IMAGE_TAGS=latest 2.1.1
IMAGE_TAGS=
